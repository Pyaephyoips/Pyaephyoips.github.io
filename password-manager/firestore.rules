rules_version = '2';

// Each signed-in user may only read/write their own vault document. The
// document ID is the Firebase Auth UID, so there is no way for one account
// to reach another account's data through these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
